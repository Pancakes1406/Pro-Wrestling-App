        "# Each drug maps to the diseases it already treats\n",
        "known_uses = {\n",
        "    \"metformin\":     [\"type 2 diabetes\"],\n",
        "    \"aspirin\":       [\"heart disease\", \"pain\"],\n",
        "    \"dexamethasone\": [\"inflammation\", \"allergic reactions\"],\n",
        "    \"methotrexate\":  [\"rheumatoid arthritis\", \"cancer\"],\n",
        "    \"ibuprofen\": [\"pain\", \"fever\"],\n",
        "}\n",
        "\n",
        "# Each drug maps to the biological targets it affects\n",
        "drug_targets = {\n",
        "    \"metformin\":     [\"AMPK\", \"mTOR\"],\n",
        "    \"aspirin\":       [\"COX1\", \"COX2\", \"NF-kB\"],\n",
        "    \"dexamethasone\": [\"glucocorticoid receptor\", \"NF-kB\"],\n",
        "    \"methotrexate\":  [\"DHFR\", \"mTOR\"],\n",
        "    \"ibuprofen\": [\"COX1\", \"COX2\", \"IL-6\"],\n",
        "}\n",
        "\n",
        "# Each disease maps to the biological targets involved in it\n",
        "disease_targets = {\n",
        "    \"type 2 diabetes\":      [\"AMPK\", \"mTOR\", \"insulin receptor\"],\n",
        "    \"cancer\":               [\"mTOR\", \"DHFR\", \"NF-kB\"],\n",
        "    \"alzheimers\":           [\"AMPK\", \"mTOR\", \"NF-kB\"],\n",
        "    \"rheumatoid arthritis\": [\"COX2\", \"NF-kB\", \"DHFR\"],\n",
        "    \"heart disease\":        [\"COX1\", \"COX2\", \"NF-kB\"],\n",
        "    \"polycystic ovary\":     [\"AMPK\", \"insulin receptor\"],\n",
        "    \"lupus\": [\"IL-6\", \"NF-kB\"],\n",
        "}"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def find_matches(drug_targets, disease_targets, known_uses):\n",
        "    matches = {}\n",
        "\n",
        "    for drug, targets in drug_targets.items():\n",
        "\n",
        "        # Convert this drug's targets to a set for fast comparison\n",
        "        drug_target_set = set(targets)\n",
        "\n",
        "        for disease, d_targets in disease_targets.items():\n",
        "\n",
        "            # Find targets the drug and disease have in common\n",
        "            shared = drug_target_set.intersection(set(d_targets))\n",
        "\n",
        "            if shared:\n",
        "                already_known = disease in known_uses.get(drug, [])\n",
        "\n",
        "                matches[(drug, disease)] = {\n",
        "                    \"shared_targets\": shared,\n",
        "                    \"already_known\":  already_known,\n",
        "                }\n",
        "\n",
        "    return matches"
      ],
      "metadata": {
        "id": "l1xn9SujuKIJ"
      },
      "execution_count": 33,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "results = find_matches(drug_targets, disease_targets, known_uses)\n",
        "\n",
        "print(\"=== EveryCure-style Drug Repurposing Results ===\")\n",
        "print()\n",
        "\n",
        "for (drug, disease), info in results.items():\n",
        "\n",
        "    status = \"KNOWN USE\" if info[\"already_known\"] else \"POSSIBLE NEW USE\"\n",
